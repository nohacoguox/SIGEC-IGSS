# Backend — copiar a .env y ajustar (no subir .env al repositorio)

PORT=3001
NODE_ENV=development

# PostgreSQL
# Base: nombre lógico IGSS → identificador en PostgreSQL: igss (minúsculas; convención estándar)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=igss
DB_USER=portal_app
DB_PASSWORD=cambiar_por_contraseña_segura
# Esquema SIGEC-IGSS (Sistema Integral de Gestión de Expedientes de Compras del IGSS)
# Nombre técnico sin guiones: sigec_igss (los guiones en identificadores obligan a comillas en SQL)
DB_SCHEMA=sigec_igss

# true solo en desarrollo / primer arranque con BD vacía; en BD existente usar false
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=generar_con_openssl_rand_base64_32

# Correo institucional para recuperación de contraseña
MAIL_HOST=smtp.ejemplo.gob.gt
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=cuenta-sistema@ejemplo.gob.gt
MAIL_PASSWORD=usar_contrasena_de_aplicacion
MAIL_FROM=SIGEC-IGSS <cuenta-sistema@ejemplo.gob.gt>
